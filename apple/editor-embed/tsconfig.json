{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"useDefineForClassFields": true
	},
	"include": ["editor.ts"]
}
